# Copy to .env for a new installation; preserve any existing credentials.
MISTRAL_API_KEY=your-mistral-api-key
SERVER_URL=https://api.mistral.ai
DEPLOYMENT_NAME=voxbridge-local

# Backend and worker must use the same data folder and deployment name.
# DATA_DIR=/absolute/path/to/demo-voxtral/data
TRANSCRIPTION_MODEL=voxtral-mini-transcribe-realtime-2602
TRANSLATION_MODEL=mistral-medium-latest
# Optional: defaults to TRANSLATION_MODEL for transcript KPI extraction.
# INTELLIGENCE_MODEL=mistral-medium-latest
SPEECH_MODEL=voxtral-mini-tts-2603

# Optional: a Mistral preset voice ID. Otherwise a preset is selected in the workflow.
# DEFAULT_VOICE_ID=
